{
  "name": "dawn-patrol-desktop",
  "productName": "Dawn Patrol",
  "version": "1.0.0",
  "description": "Surf conditions, forecasts and spot scouting - desktop app for Windows",
  "main": "src/main.js",
  "author": "Dawn Patrol",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "org.casadelfuego.dawnpatrol",
    "productName": "Dawn Patrol",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dawn Patrol"
    },
    "portable": { "artifactName": "DawnPatrol-Portable-${version}.exe" }
  }
}
